// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  username String @unique
  password String
  status   Status @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  roles                      UserRole[]
  tagsCreated                Tag[]                @relation("TagCreatedBy")
  tagsUpdated                Tag[]                @relation("TagUpdatedBy")
  usersCreated               User[]               @relation("UserCreatedBy")
  usersUpdated               User[]               @relation("UserUpdatedBy")
  rolesCreated               Role[]               @relation("RoleCreatedBy")
  rolesUpdated               Role[]               @relation("RoleUpdatedBy")
  memberTypesCreated         MemberType[]         @relation("MemberTypeCreatedBy")
  memberTypesUpdated         MemberType[]         @relation("MemberTypeUpdatedBy")
  memberPlansCreated         MemberPlan[]         @relation("MemberPlanCreatedBy")
  memberPlansUpdated         MemberPlan[]         @relation("MemberPlanUpdatedBy")
  prosCreated                Pros[]               @relation("ProsCreatedBy")
  prosUpdated                Pros[]               @relation("ProsUpdatedBy")
  consCreated                Cons[]               @relation("ConsCreatedBy")
  consUpdated                Cons[]               @relation("ConsUpdatedBy")
  memberCreaded              Member[]             @relation("MemberCreatedBy")
  memberUpdated              Member[]             @relation("MemberUpdatedBy")
  bodyGoalsCreated           BodyGoal[]           @relation("BodyGoalCreatedBy")
  bodyGoalsUpdated           BodyGoal[]           @relation("BodyGoalUpdatedBy")
  proficientLevelsCreated    ProficientLevel[]    @relation("ProficientLevelCreatedBy")
  proficientLevelsUpdated    ProficientLevel[]    @relation("ProficientLevelUpdatedBy")
  categoriesCreated          Category[]           @relation("CategoryCreatedBy")
  categoriesUpdated          Category[]           @relation("CategoryUpdatedBy")
  placesCreated              Place[]              @relation("PlaceCreatedBy")
  placesUpdated              Place[]              @relation("PlaceUpdatedBy")
  workoutsCreated            Workout[]            @relation("WorkoutCreatedBy")
  workoutsUpdated            Workout[]            @relation("WorkoutUpdatedBy")
  bankInformationCreated     BankInformation[]    @relation("BankInformationCreatedBy")
  bankInformationUpdated     BankInformation[]    @relation("BankInformationUpdatedBy")
  shopLevelsCreated          ShopLevel[]          @relation("ShopLevelCreatedBy")
  shopLevelsUpdated          ShopLevel[]          @relation("ShopLevelUpdatedBy")
  shopsCreated               Shop[]               @relation("ShopCreatedBy")
  shopsUpdated               Shop[]               @relation("ShopUpdatedBy")
  physicalLimitationsCreated PhysicalLimitation[] @relation("PhysicalLimitationCreatedBy")
  physicalLimitationsUpdated PhysicalLimitation[] @relation("PhysicalLimitationUpdatedBy")
  dietTypeCreated            DietType[]           @relation("DietTypeCreatedBy")
  dietTypeUpdated            DietType[]           @relation("DietTypeUpdatedBy")
  bodyAttentionAreasCreated  BodyAttentionArea[]  @relation("BodyAttentionAreaCreatedBy")
  bodyAttentionAreasUpdated  BodyAttentionArea[]  @relation("BodyAttentionAreaUpdatedBy")
  mealTypesCreated           MealType[]           @relation("MealTypeCreatedBy")
  mealTypesUpdated           MealType[]           @relation("MealTypeUpdatedBy")
  mealsCreated               Meal[]               @relation("MealCreatedBy")
  mealsUpdated               Meal[]               @relation("MealUpdatedBy")
  badHabitsCreated           BadHabit[]           @relation("BadHabitCreatedBy")
  badHabitsUpdated           BadHabit[]           @relation("BadHabitUpdatedBy")
  memberRequestsApproved     MemberRequest[]      @relation("MemberRequestApprovedBy")
  memberRequestsRejected     MemberRequest[]      @relation("MemberRequestRejectedBy")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String? @db.Text()
  status      Status  @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("RoleCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("RoleUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String? @db.Text()
  status      Status  @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  RolePermission RolePermission[]
}

model UserRole {
  id     Int @id @default(autoincrement())
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model MemberType {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  members Member[]
  status  Status   @default(ACTIVE)

  deletedAt      DateTime?
  createdById    Int?
  updatedById    Int?
  createdBy      User?           @relation("MemberTypeCreatedBy", fields: [createdById], references: [id])
  updatedBy      User?           @relation("MemberTypeUpdatedBy", fields: [updatedById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  memberPlans    MemberPlan[]
  memberRequests MemberRequest[]
}

model MemberPlan {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  image        String?
  memberType   MemberType @relation(fields: [memberTypeId], references: [id], onDelete: Cascade)
  memberTypeId Int
  price        Int        @default(0)
  pros         Pros[]
  cons         Cons[]
  duration     Int        @default(1)
  isVideoGroup Boolean    @default(false)
  status       Status     @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("MemberPlanCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("MemberPlanUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]
  workouts    Workout[]
}

model Pros {
  id     Int    @id @default(autoincrement())
  name   String @unique
  guard  String @unique
  status Status @default(ACTIVE)

  memberPlans MemberPlan[]

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("ProsCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("ProsUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Cons {
  id     Int    @id @default(autoincrement())
  name   String
  guard  String @unique
  status Status @default(ACTIVE)

  memberPlans MemberPlan[]

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("ConsCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("ConsUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MemberRequest {
  id             Int                 @id @default(autoincrement())
  memberId       Int
  member         Member              @relation(fields: [memberId], references: [id])
  memberTypeId   Int
  memberType     MemberType          @relation(fields: [memberTypeId], references: [id])
  status         MemberRequestStatus @default(PENDING)
  rejectedReason String?             @db.Text() // Only For Rejected Member Request

  approvedById Int?
  approvedBy   User?     @relation("MemberRequestApprovedBy", fields: [approvedById], references: [id])
  rejectedById Int?
  rejectedBy   User?     @relation("MemberRequestRejectedBy", fields: [rejectedById], references: [id])
  approvedAt   DateTime?
  rejectedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([memberId, memberTypeId])
}

model Member {
  id           Int         @id @default(autoincrement())
  name         String
  code         String      @unique // YC0244
  email        String?     @unique
  phone        String?     @unique
  password     String
  memberType   MemberType? @relation(fields: [memberTypeId], references: [id], onDelete: Cascade)
  memberTypeId Int?

  profile MemberProfile?

  language Language @default(ENG)
  theme    Theme    @default(LIGHT)
  status   Status   @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("MemberCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("MemberUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  providerTypes    MemberProviderType[]
  postComments     PostComment[]
  payments         Payment[]
  shops            Shop[]
  shopRatings      ShopRating[]
  shopPostComments ShopPostComment[]
  waterTrackers    WaterTracker[]
  memberRequests   MemberRequest[]
  bodyMeasurement  BodyMeasurement?
}

model OTP {
  id         Int      @id @default(autoincrement())
  email      String?
  phone      String?
  otp        String
  expiresAt  DateTime
  isVerified Boolean  @default(false)
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([email, otp])
  @@unique([phone, otp])
}

enum ProviderType {
  GOOGLE
  FACEBOOK
  APPLE
  EMAIL
  PHONE
}

enum MemberRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model MemberProviderType {
  id       Int    @id @default(autoincrement())
  memberId Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  providerType ProviderType
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([memberId, providerType])
}

model MemberProfile {
  id       Int    @id @default(autoincrement())
  memberId Int    @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  address      String?
  profilePhoto String?
  coverPhoto   String?
  bio          String? @db.Text()
  gender       Gender?
  age          Int?
  yearOfExp    Int?    @default(0) // Only For Trainer Member
  reason       String? @db.Text() // Only For Trainer Member
  certificates Json? // Only For Trainer Member
  photos       Json? // Only For Trainer Member

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BodyMeasurement {
  id       Int    @id @default(autoincrement())
  memberId Int    @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  heightFeet   String?
  heightInches String?
  weight       String?
  neck         String?
  waist        String?
  shoulders    String?
  thigh        String?
  calf         String?
  arms         String?
  wrist        String?
  chest        String?
  hip          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Language {
  ENG
  MM
}

enum Theme {
  DARK
  PINK
  LIGHT
}

model ShopLevel {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  price       Int     @default(0)
  duration    Int     @default(0)
  description String? @db.Text()
  postLimit   Int     @default(10)
  status      Status  @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("ShopLevelCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("ShopLevelUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shops Shop[]
}

model Shop {
  id    Int     @id @default(autoincrement())
  name  String
  image String?

  memberId Int    @unique
  member   Member @relation(fields: [memberId], references: [id])

  shopLevelId Int?
  shopLevel   ShopLevel? @relation(fields: [shopLevelId], references: [id])
  status      Status     @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("ShopCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("ShopUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shopRatings ShopRating[]
  shopPosts   ShopPost[]
}

model ShopRating {
  id     Int     @id @default(autoincrement())
  rate   Int     @default(0)
  review String? @db.Text()

  memberId Int
  member   Member @relation(fields: [memberId], references: [id])

  shopId Int
  shop   Shop @relation(fields: [shopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShopPost {
  id           Int          @id @default(autoincrement())
  caption      String
  privencyType PrivencyType @default(PUBLIC)
  images       Json

  shop   Shop @relation(fields: [shopId], references: [id])
  shopId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shopPostComments ShopPostComment[]
}

model ShopPostComment {
  id         Int               @id @default(autoincrement())
  shopPost   ShopPost          @relation(fields: [shopPostId], references: [id], onDelete: Cascade)
  shopPostId Int
  memberId   Int
  member     Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  comment    String            @db.Text()
  parentId   Int?
  parent     ShopPostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    ShopPostComment[] @relation("CommentReplies")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model Tag {
  id     Int    @id @default(autoincrement())
  name   String @unique
  status Status @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("TagCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("TagUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  posts Post[]
}

model Post {
  id           Int          @id @default(autoincrement())
  content      String
  tag          Tag          @relation(fields: [tagId], references: [id])
  tagId        Int
  privencyType PrivencyType @default(PUBLIC)
  timeAgo      String
  media        Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  postComments PostComment[]
}

enum PrivencyType {
  PUBLIC
  PRIVATE
  FRIEND
}

model PostComment {
  id        Int           @id @default(autoincrement())
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  memberId  Int
  member    Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  comment   String        @db.Text()
  parentId  Int?
  parent    PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentReplies")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model BodyGoal {
  id     Int    @id @default(autoincrement())
  name   String @unique
  status Status @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("BodyGoalCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("BodyGoalUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workouts Workout[]
}

model ProficientLevel {
  id     Int    @id @default(autoincrement())
  name   String @unique
  status Status @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("ProficientLevelCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("ProficientLevelUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workouts    Workout[]
}

model Category {
  id     Int    @id @default(autoincrement())
  name   String @unique
  status Status @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("CategoryUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workouts Workout[]
}

enum Gender {
  MALE
  FEMALE
  BOTH
}

model Place {
  id     Int    @id @default(autoincrement())
  name   String @unique
  status Status @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("PlaceCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("PlaceUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workouts    Workout[]
}

enum Day {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model Workout {
  id        Int     @id @default(autoincrement())
  video     String
  thumbnail String?
  name      String
  gender    Gender

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  bodyGoal   BodyGoal @relation(fields: [bodyGoalId], references: [id])
  bodyGoalId Int

  proficientLevel   ProficientLevel @relation(fields: [proficientLevelId], references: [id])
  proficientLevelId Int

  place   Place @relation(fields: [placeId], references: [id])
  placeId Int

  memberPlan   MemberPlan @relation(fields: [memberPlanId], references: [id])
  memberPlanId Int

  workoutDay Day?

  videoDuration Int @default(0) // in seconds

  sets Int?
  reps Int?

  status Status @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("WorkoutCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("WorkoutUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PhysicalLimitation {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  photo       String?
  description String? @db.Text()
  status      Status  @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("PhysicalLimitationCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("PhysicalLimitationUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model DietType {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  photo       String?
  description String? @db.Text()
  status      Status  @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("DietTypeCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("DietTypeUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BodyAttentionArea {
  id     Int    @id @default(autoincrement())
  name   String @unique
  status Status @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("BodyAttentionAreaCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("BodyAttentionAreaUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MealType {
  id     Int    @id @default(autoincrement())
  name   String @unique
  status Status @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("MealTypeCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("MealTypeUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  meals       Meal[]
}

model Meal {
  id      Int    @id @default(autoincrement())
  name    String
  cal     Float  @default(0.00)
  carb    Float  @default(0.00)
  protein Float  @default(0.00)
  fat     Float  @default(0.00)

  mealTypeId Int
  mealType   MealType @relation(fields: [mealTypeId], references: [id])

  status Status @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("MealCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("MealUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BadHabit {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String? @db.Text()
  photo       String?
  status      Status  @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("BadHabitCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("BadHabitUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WaterTracker {
  id         Int    @id @default(autoincrement())
  date       String
  memberId   Int
  member     Member @relation(fields: [memberId], references: [id])
  dailyWater Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankInformation {
  id                Int     @id @default(autoincrement())
  coverPhoto        String?
  bankAccountHolder String
  bankAccountNumber String  @unique
  phone             String

  paymentTypes PaymentTypes @default(BANK_ACCOUNT)
  status       Status       @default(ACTIVE)

  deletedAt   DateTime?
  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("BankInformationCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("BankInformationUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Payment {
  id           Int           @id @default(autoincrement())
  memberId     Int
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberPlan   MemberPlan    @relation(fields: [memberPlanId], references: [id])
  memberPlanId Int
  amount       Int           @default(0)
  attachment   String
  status       PaymentStatus @default(OPEN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum PaymentTypes {
  BANK_ACCOUNT
  E_WALLET
}

enum PaymentStatus {
  OPEN
  PAID
  CANCELLED
}

enum Status {
  ACTIVE
  INACTIVE
  DELETE
}
