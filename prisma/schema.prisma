// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  output     = "../node_modules/.prisma/client"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  username String @unique
  password String
  status   Status @default(ACTIVE)

  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles                       UserRole[]
  tagsCreated                 Tag[]                @relation("TagCreatedBy")
  tagsUpdated                 Tag[]                @relation("TagUpdatedBy")
  usersCreated                User[]               @relation("UserCreatedBy")
  usersUpdated                User[]               @relation("UserUpdatedBy")
  rolesCreated                Role[]               @relation("RoleCreatedBy")
  rolesUpdated                Role[]               @relation("RoleUpdatedBy")
  memberPlansCreated          MemberPlan[]         @relation("MemberPlanCreatedBy")
  memberPlansUpdated          MemberPlan[]         @relation("MemberPlanUpdatedBy")
  prosCreated                 Pros[]               @relation("ProsCreatedBy")
  prosUpdated                 Pros[]               @relation("ProsUpdatedBy")
  consCreated                 Cons[]               @relation("ConsCreatedBy")
  consUpdated                 Cons[]               @relation("ConsUpdatedBy")
  memberCreated               Member[]             @relation("MemberCreatedBy")
  memberUpdated               Member[]             @relation("MemberUpdatedBy")
  bodyGoalsCreated            BodyGoal[]           @relation("BodyGoalCreatedBy")
  bodyGoalsUpdated            BodyGoal[]           @relation("BodyGoalUpdatedBy")
  proficientLevelsCreated     ProficientLevel[]    @relation("ProficientLevelCreatedBy")
  proficientLevelsUpdated     ProficientLevel[]    @relation("ProficientLevelUpdatedBy")
  categoriesCreated           Category[]           @relation("CategoryCreatedBy")
  categoriesUpdated           Category[]           @relation("CategoryUpdatedBy")
  placesCreated               Place[]              @relation("PlaceCreatedBy")
  placesUpdated               Place[]              @relation("PlaceUpdatedBy")
  workoutsCreated             Workout[]            @relation("WorkoutCreatedBy")
  workoutsUpdated             Workout[]            @relation("WorkoutUpdatedBy")
  bankInformationCreated      BankInformation[]    @relation("BankInformationCreatedBy")
  bankInformationUpdated      BankInformation[]    @relation("BankInformationUpdatedBy")
  shopLevelsCreated           ShopLevel[]          @relation("ShopLevelCreatedBy")
  shopLevelsUpdated           ShopLevel[]          @relation("ShopLevelUpdatedBy")
  shopsCreated                Shop[]               @relation("ShopCreatedBy")
  shopsUpdated                Shop[]               @relation("ShopUpdatedBy")
  physicalLimitationsCreated  PhysicalLimitation[] @relation("PhysicalLimitationCreatedBy")
  physicalLimitationsUpdated  PhysicalLimitation[] @relation("PhysicalLimitationUpdatedBy")
  dietTypeCreated             DietType[]           @relation("DietTypeCreatedBy")
  dietTypeUpdated             DietType[]           @relation("DietTypeUpdatedBy")
  bodyAttentionAreasCreated   BodyAttentionArea[]  @relation("BodyAttentionAreaCreatedBy")
  bodyAttentionAreasUpdated   BodyAttentionArea[]  @relation("BodyAttentionAreaUpdatedBy")
  mealsCreated                Meal[]               @relation("MealCreatedBy")
  mealsUpdated                Meal[]               @relation("MealUpdatedBy")
  badHabitsCreated            BadHabit[]           @relation("BadHabitCreatedBy")
  badHabitsUpdated            BadHabit[]           @relation("BadHabitUpdatedBy")
  memberRequestsApproved      MemberRequest[]      @relation("MemberRequestApprovedBy")
  memberRequestsRejected      MemberRequest[]      @relation("MemberRequestRejectedBy")
  paymentsCancelled           Payment[]            @relation("PaymentCancelledBy")
  paymentsApproved            Payment[]            @relation("PaymentApprovedBy")
  shopUpgradeRequestsApproved ShopUpgradeRequest[] @relation("ShopUpgradeRequestApprovedBy")
  shopUpgradeRequestsRejected ShopUpgradeRequest[] @relation("ShopUpgradeRequestRejectedBy")
  attendancesCreated          Attendance[]         @relation("AttendanceCreatedBy")
  attendancesUpdated          Attendance[]         @relation("AttendanceUpdatedBy")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String? @db.Text()
  status      Status  @default(ACTIVE)

  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("RoleCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("RoleUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String? @db.Text()
  status      Status  @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  RolePermission RolePermission[]
}

model UserRole {
  id     Int @id @default(autoincrement())
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model MemberType {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  members Member[]
  status  Status   @default(ACTIVE)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  memberPlans    MemberPlan[]
  memberRequests MemberRequest[]
  payments       Payment[]
}

model MemberPlan {
  id           Int        @id @default(autoincrement())
  name         String
  image        String?
  memberType   MemberType @relation(fields: [memberTypeId], references: [id], onDelete: Cascade)
  memberTypeId Int
  price        Int        @default(0)
  pros         Pros[]
  cons         Cons[]
  duration     Int        @default(1)
  expiredAt    String?
  isVideoGroup Boolean    @default(false)
  status       Status     @default(ACTIVE)

  createdById    Int?
  updatedById    Int?
  createdBy      User?           @relation("MemberPlanCreatedBy", fields: [createdById], references: [id])
  updatedBy      User?           @relation("MemberPlanUpdatedBy", fields: [updatedById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  payments       Payment[]
  workouts       Workout[]
  memberRequests MemberRequest[]
  conversations  Conversation[]
}

model Pros {
  id     Int    @id @default(autoincrement())
  name   String @unique
  guard  String
  status Status @default(ACTIVE)

  memberPlans MemberPlan[]

  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("ProsCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("ProsUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Cons {
  id     Int    @id @default(autoincrement())
  name   String @unique
  guard  String
  status Status @default(ACTIVE)

  memberPlans MemberPlan[]

  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("ConsCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("ConsUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MemberRequest {
  id Int @id @default(autoincrement())

  memberId Int
  member   Member @relation(fields: [memberId], references: [id])

  memberTypeId Int
  memberType   MemberType @relation(fields: [memberTypeId], references: [id])

  memberPlanId Int
  memberPlan   MemberPlan @relation(fields: [memberPlanId], references: [id])

  age          Int?
  gender       Gender?
  yearOfExp    Int?
  reason       String? @db.Text()
  certificates Json?
  photos       Json?

  status         MemberRequestStatus @default(PENDING)
  rejectedReason String?             @db.Text() // Only For Rejected Member Request

  approvedById Int?
  approvedBy   User?     @relation("MemberRequestApprovedBy", fields: [approvedById], references: [id])
  rejectedById Int?
  rejectedBy   User?     @relation("MemberRequestRejectedBy", fields: [rejectedById], references: [id])
  approvedAt   DateTime?
  rejectedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Member {
  id           Int         @id @default(autoincrement())
  name         String
  code         String      @unique // YC0244
  email        String?     @unique
  phone        String?     @unique
  password     String
  memberType   MemberType? @relation(fields: [memberTypeId], references: [id], onDelete: Cascade)
  memberTypeId Int?

  bodyGoalId Int?
  bodyGoal   BodyGoal? @relation(fields: [bodyGoalId], references: [id])

  proficientLevelId Int?
  proficientLevel   ProficientLevel? @relation(fields: [proficientLevelId], references: [id])

  profile MemberProfile?

  language Language @default(ENG)
  theme    Theme    @default(LIGHT)
  status   Status   @default(ACTIVE)

  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("MemberCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("MemberUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providerTypes            MemberProviderType[]
  postComments             PostComment[]
  payments                 Payment[]
  shop                     Shop?
  shopRatings              ShopRating[]
  waterTrackers            WaterTracker[]
  memberRequests           MemberRequest[]
  bodyMeasurement          BodyMeasurement?
  shopUpgradeRequests      ShopUpgradeRequest[]
  posts                    Post[]
  friends                  Friend[]                  @relation("MemberFriends")
  friendsOf                Friend[]                  @relation("MemberFriend")
  friendRequests           FriendRequest[]           @relation("MemberFriendRequestSender")
  friendRequestsOf         FriendRequest[]           @relation("MemberFriendRequestReceiver")
  fcmToken                 MemberFcmToken?
  postReactions            PostReaction[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  attendances              Attendance[]
  messageReactions         MessageReaction[]
  postCommentReactions     PostCommentReaction[]
  blocks                   Block[]                   @relation("MemberBlocked")
  blockedBy                Block[]                   @relation("MemberBlockedBy")
  mealTrackers             MealTracker[]
}

model MemberFcmToken {
  id         Int        @id @default(autoincrement())
  memberId   Int        @unique
  member     Member     @relation(fields: [memberId], references: [id])
  token      String
  deviceType DeviceType @default(ANDROID)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([memberId, token])
}

model OTP {
  id         Int      @id @default(autoincrement())
  email      String?
  phone      String?
  otp        String
  expiresAt  DateTime
  isVerified Boolean  @default(false)
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([email, otp])
  @@unique([phone, otp])
}

enum ProviderType {
  GOOGLE
  FACEBOOK
  APPLE
  EMAIL
  PHONE
}

enum MemberRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model MemberProviderType {
  id       Int    @id @default(autoincrement())
  memberId Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  providerType ProviderType
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([memberId, providerType])
}

model MemberProfile {
  id       Int    @id @default(autoincrement())
  memberId Int    @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  address      String?
  profilePhoto String?
  coverPhoto   String?
  bio          String? @db.Text()
  gender       Gender?
  age          Int?
  yearOfExp    Int?    @default(0) // Only For Trainer Member
  reason       String? @db.Text() // Only For Trainer Member
  certificates Json? // Only For Trainer Member
  photos       Json? // Only For Trainer Member

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BodyMeasurement {
  id       Int    @id @default(autoincrement())
  memberId Int    @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  heightFeet   String?
  heightInches String?
  weight       String?
  neck         String?
  waist        String?
  shoulders    String?
  thigh        String?
  calf         String?
  arms         String?
  wrist        String?
  chest        String?
  hip          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Language {
  ENG
  MM
}

enum Theme {
  DARK
  PINK
  LIGHT
}

model ShopLevel {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  price       Int     @default(0)
  duration    Int     @default(0)
  description String? @db.Text()
  postLimit   Int     @default(10)
  status      Status  @default(ACTIVE)

  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("ShopLevelCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("ShopLevelUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shops               Shop[]
  shopUpgradeRequests ShopUpgradeRequest[]
  payments            Payment[]
}

model Shop {
  id   Int     @id @default(autoincrement())
  name String
  logo String?

  memberId Int?    @unique
  member   Member? @relation(fields: [memberId], references: [id])

  shopLevelId Int?
  shopLevel   ShopLevel? @relation(fields: [shopLevelId], references: [id])
  status      Status     @default(ACTIVE)

  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("ShopCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("ShopUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shopRatings ShopRating[]
  posts       Post[]
}

model ShopUpgradeRequest {
  id Int @id @default(autoincrement())

  memberId Int
  member   Member @relation(fields: [memberId], references: [id])

  shopLevelId Int
  shopLevel   ShopLevel @relation(fields: [shopLevelId], references: [id])

  status         MemberRequestStatus @default(PENDING)
  rejectedReason String?             @db.Text() // Only For Rejected Shop Upgrade Request

  approvedById Int?
  approvedBy   User?     @relation("ShopUpgradeRequestApprovedBy", fields: [approvedById], references: [id])
  rejectedById Int?
  rejectedBy   User?     @relation("ShopUpgradeRequestRejectedBy", fields: [rejectedById], references: [id])
  approvedAt   DateTime?
  rejectedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ShopRating {
  id     Int     @id @default(autoincrement())
  rate   Int     @default(0)
  review String? @db.Text()

  memberId Int
  member   Member @relation(fields: [memberId], references: [id])

  shopId Int
  shop   Shop @relation(fields: [shopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, shopId])
}

model Tag {
  id     Int    @id @default(autoincrement())
  name   String @unique
  status Status @default(ACTIVE)

  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("TagCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("TagUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]
}

model Post {
  id           Int           @id @default(autoincrement())
  content      Json
  tag          Tag?          @relation(fields: [tagId], references: [id])
  tagId        Int?
  privencyType PrivencyType? @default(PUBLIC)
  timeAgo      DateTime      @default(now())
  media        Json
  viewCount    Int           @default(0)

  shop   Shop? @relation(fields: [shopId], references: [id])
  shopId Int?

  memberId Int
  member   Member @relation(fields: [memberId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postComments  PostComment[]
  postReactions PostReaction[]
}

model PostReaction {
  id       Int    @id @default(autoincrement())
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId   Int
  memberId Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, memberId])
}

enum PrivencyType {
  PUBLIC
  PRIVATE
  FRIEND
}

model PostComment {
  id        Int           @id @default(autoincrement())
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  memberId  Int
  member    Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  comment   String        @db.Text()
  parentId  Int?
  parent    PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentReplies")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  postCommentReactions PostCommentReaction[]
}

model PostCommentReaction {
  id Int @id @default(autoincrement())

  postCommentId Int
  postComment   PostComment @relation(fields: [postCommentId], references: [id], onDelete: Cascade)

  memberId Int
  member   Member @relation(fields: [memberId], references: [id])

  reaction String // 👍 ❤️ 😂 😢 😮

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postCommentId, memberId])
}

model BodyGoal {
  id     Int    @id @default(autoincrement())
  name   String @unique
  status Status @default(ACTIVE)

  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("BodyGoalCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("BodyGoalUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workouts      Workout[]
  conversations Conversation[]
  members       Member[]
}

model ProficientLevel {
  id     Int    @id @default(autoincrement())
  name   String @unique
  status Status @default(ACTIVE)

  createdById   Int?
  updatedById   Int?
  createdBy     User?          @relation("ProficientLevelCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?          @relation("ProficientLevelUpdatedBy", fields: [updatedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  workouts      Workout[]
  conversations Conversation[]
  members       Member[]
}

model Category {
  id     Int    @id @default(autoincrement())
  name   String @unique
  status Status @default(ACTIVE)

  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("CategoryUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workouts Workout[]
}

enum Gender {
  MALE
  FEMALE
  BOTH
}

model Place {
  id     Int    @id @default(autoincrement())
  name   String @unique
  status Status @default(ACTIVE)

  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("PlaceCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("PlaceUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workouts    Workout[]
}

enum Day {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model Workout {
  id        Int     @id @default(autoincrement())
  video     String
  thumbnail String?
  name      String
  gender    Gender

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  bodyGoal   BodyGoal @relation(fields: [bodyGoalId], references: [id])
  bodyGoalId Int

  proficientLevel   ProficientLevel @relation(fields: [proficientLevelId], references: [id])
  proficientLevelId Int

  place   Place @relation(fields: [placeId], references: [id])
  placeId Int

  memberPlan   MemberPlan @relation(fields: [memberPlanId], references: [id])
  memberPlanId Int

  workoutDay Day?

  videoDuration Int @default(0) // in seconds

  sets Int?
  reps Int?

  status Status @default(ACTIVE)

  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("WorkoutCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("WorkoutUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PhysicalLimitation {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  photo       String?
  description String? @db.Text()
  status      Status  @default(ACTIVE)

  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("PhysicalLimitationCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("PhysicalLimitationUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DietType {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  photo       String?
  description String? @db.Text()
  status      Status  @default(ACTIVE)

  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("DietTypeCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("DietTypeUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BodyAttentionArea {
  id     Int    @id @default(autoincrement())
  name   String @unique
  status Status @default(ACTIVE)

  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("BodyAttentionAreaCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("BodyAttentionAreaUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Meal {
  id       Int     @id @default(autoincrement())
  name     String
  cal      Float   @default(0.00)
  carb     Float   @default(0.00)
  protein  Float   @default(0.00)
  fat      Float   @default(0.00)
  mealType String?
  status   Status  @default(ACTIVE)

  createdById  Int?
  updatedById  Int?
  createdBy    User?         @relation("MealCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?         @relation("MealUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  mealTrackers MealTracker[]
}

model MealTracker {
  id           Int      @id @default(autoincrement())
  mealId       Int
  meal         Meal     @relation(fields: [mealId], references: [id])
  memberId     Int
  member       Member   @relation(fields: [memberId], references: [id])
  date         String
  totalCal     Float    @default(0.00)
  totalCarb    Float    @default(0.00)
  totalProtein Float    @default(0.00)
  totalFat     Float    @default(0.00)
  quantity     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BadHabit {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String? @db.Text()
  photo       String?
  status      Status  @default(ACTIVE)

  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("BadHabitCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("BadHabitUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WaterTracker {
  id         Int    @id @default(autoincrement())
  date       String
  memberId   Int
  member     Member @relation(fields: [memberId], references: [id])
  dailyWater Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, date])
}

model BankInformation {
  id                Int     @id @default(autoincrement())
  coverPhoto        String?
  bankAccountHolder String
  bankAccountNumber String
  phone             String

  paymentTypes PaymentTypes @default(BANK_ACCOUNT)
  status       Status       @default(ACTIVE)

  createdById Int?
  updatedById Int?
  createdBy   User?     @relation("BankInformationCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("BankInformationUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]
}

model Payment {
  id Int @id @default(autoincrement())

  memberId Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  requestType PaymentRequestType @default(MEMBER_PLAN_UPGRADE)

  memberPlan   MemberPlan? @relation(fields: [memberPlanId], references: [id]) // Only for member upgrade 
  memberPlanId Int? // Only for member upgrade 

  memberTypeId Int? // Only for member upgrade 
  memberType   MemberType? @relation(fields: [memberTypeId], references: [id]) // Only for member upgrade 

  shopLevelId Int? // Only for shop level upgrade 
  shopLevel   ShopLevel? @relation(fields: [shopLevelId], references: [id]) // // Only for shop level upgrade 

  bankInformationId Int
  bankInformation   BankInformation @relation(fields: [bankInformationId], references: [id])

  amount      Int       @default(0)
  attachment  String
  requestDate DateTime? @default(now())

  status PaymentStatus @default(DRAFT)

  approvedBy   User?     @relation("PaymentApprovedBy", fields: [approvedById], references: [id])
  approvedById Int?
  approvedAt   DateTime?

  cancelledBy     User?     @relation("PaymentCancelledBy", fields: [cancelledById], references: [id])
  cancelledById   Int?
  cancelledAt     DateTime?
  cancelledReason String?   @db.Text()

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id       Int    @id @default(autoincrement())
  memberId Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date     String

  createdById Int?
  updatedById Int?
  createdBy   User?    @relation("AttendanceCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?    @relation("AttendanceUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([memberId, date])
}

model FriendRequest {
  id Int @id @default(autoincrement())

  senderId Int
  sender   Member @relation("MemberFriendRequestSender", fields: [senderId], references: [id])

  receiverId Int
  receiver   Member @relation("MemberFriendRequestReceiver", fields: [receiverId], references: [id])

  status FriendRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senderId, receiverId])
}

model Friend {
  id Int @id @default(autoincrement())

  memberId Int
  member   Member @relation("MemberFriends", fields: [memberId], references: [id])

  friendId Int
  friend   Member @relation("MemberFriend", fields: [friendId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, friendId])
}

model Notification {
  id      Int              @id @default(autoincrement())
  title   String
  message String
  type    NotificationType @default(INFO)
  status  Status           @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id    Int              @id @default(autoincrement())
  image String?
  type  ConversationType @default(PRIVATE)
  name  String?

  memberPlanId Int?
  memberPlan   MemberPlan? @relation(fields: [memberPlanId], references: [id])

  proficientLevelId Int?
  proficientLevel   ProficientLevel? @relation(fields: [proficientLevelId], references: [id])

  gender Gender?

  bodyGoalId Int?
  bodyGoal   BodyGoal? @relation(fields: [bodyGoalId], references: [id])

  status ConversationStatus @default(REQUESTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

enum ConversationType {
  PRIVATE
  GROUP
  TRAINER_GROUP
}

enum ConversationStatus {
  REQUESTED
  ACCEPTED
  CANCELED
}

model ConversationParticipant {
  id             Int             @id @default(autoincrement())
  conversationId Int
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  memberId       Int
  member         Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role           ParticipantRole @default(MEMBER)
  joinedAt       DateTime        @default(now())
  lastReadAt     DateTime?
  isArchived     Boolean         @default(false)
  archivedAt     DateTime?

  @@unique([conversationId, memberId])
}

enum ParticipantRole {
  ADMIN
  MEMBER
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         Member       @relation(fields: [senderId], references: [id])
  content        String       @db.Text()
  attachments    Json
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messageReactions MessageReaction[]
}

model MessageReaction {
  id Int @id @default(autoincrement())

  messageId Int
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  memberId Int
  member   Member @relation(fields: [memberId], references: [id])

  reaction String // 👍 ❤️ 😂 😢 😮

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, memberId])
}

model Block {
  id              Int      @id @default(autoincrement())
  memberId        Int
  member          Member   @relation("MemberBlocked", fields: [memberId], references: [id])
  blockedMemberId Int
  blockedMember   Member   @relation("MemberBlockedBy", fields: [blockedMemberId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([memberId, blockedMemberId])
}

enum NotificationType {
  INFO
  WARNING
  ERROR
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum PaymentRequestType {
  MEMBER_PLAN_UPGRADE
  SHOP_LEVEL_UPGRADE
}

enum PaymentTypes {
  BANK_ACCOUNT
  E_WALLET
}

enum PaymentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  PAID
}

enum Status {
  ACTIVE
  INACTIVE
}

enum DeviceType {
  ANDROID
  IOS
  WEB
}
