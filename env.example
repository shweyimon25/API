# Server
PORT=3000

# JWT
JWT_SECRET=your_jwt_secret

# Database (Prisma)
# Example for local MySQL on host
DATABASE_URL=mysql://user:password@localhost:3306/yc_fitness

# MySQL container (docker-compose) overrides
DB_ROOT_PASSWORD=rootpassword
DB_NAME=yc_fitness
DB_USER=user
DB_PASSWORD=password
DB_PORT=3306
PMA_PORT=8080

# Mail (nodemailer)
MAIL_HOST=smtp.example.com
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password

# OSS Storage (Alibaba Cloud OSS or S3-compatible like DigitalOcean Spaces)
# Region format: oss-{region} (e.g., oss-cn-hangzhou, oss-sgp1, oss-us-west-1)
# For DigitalOcean Spaces, you can use any value (e.g., sgp1)
OSS_REGION=oss-sgp1
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
# Bucket name (without endpoint)
OSS_BUCKET=your_bucket_name
# Endpoint format (without https://):
# - Alibaba OSS: oss-{region}.aliyuncs.com (e.g., oss-sgp1.aliyuncs.com)
# - DigitalOcean Spaces: {region}.digitaloceanspaces.com (e.g., sgp1.digitaloceanspaces.com)
# - Other S3-compatible: {your-endpoint-domain}
# If not provided, will be auto-constructed from OSS_REGION (for Alibaba OSS only)
OSS_ENDPOINT=oss-sgp1.aliyuncs.com
# For DigitalOcean Spaces example:
# OSS_ENDPOINT=sgp1.digitaloceanspaces.com
OSS_SECURE=true

