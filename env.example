# Server
PORT=3000

# JWT
JWT_SECRET=your_jwt_secret

# Database (Prisma)
# Example for local MySQL on host
DATABASE_URL=mysql://user:password@localhost:3306/yc_fitness

# MySQL container (docker-compose) overrides
DB_ROOT_PASSWORD=rootpassword
DB_NAME=yc_fitness
DB_USER=user
DB_PASSWORD=password
DB_PORT=3306
PMA_PORT=8080

# Mail (nodemailer)
MAIL_HOST=smtp.example.com
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password

